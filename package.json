{
  "name": "holmia",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "test:repositories": "node --experimental-strip-types src/tests/testRepositories.ts",
    "test:session": "node --experimental-strip-types src/tests/testSessionAndAccess.ts",
    "test:seller-form": "node src/tests/testSellerPropertyForm.mjs",
    "test:seller-form:supabase": "node --env-file=.env scripts/test-seller-form.mjs",
    "test:seller-edit": "node src/tests/testSellerEditRules.mjs && node --experimental-strip-types src/tests/testSellerEditDelete.ts",
    "test:offers": "node --experimental-strip-types src/tests/testOfferDecisions.ts",
    "test:enquiries": "node --experimental-strip-types src/tests/testEnquiries.ts",
    "test:persistence": "node --experimental-strip-types src/tests/testLocalPersistence.ts",
    "test:rentals": "node --experimental-strip-types src/tests/testRentalDecisions.ts",
    "test:all": "npm run test:repositories && npm run test:session && npm run test:seller-form && npm run test:seller-edit && npm run test:offers && npm run test:enquiries && npm run test:persistence && node --test tests/buyer-submissions.mjs && npm run test:rentals",
    "seed:sqlite": "node --experimental-strip-types src/database/seed.ts"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4"
  }
}
